generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  common
  admin
  superAdmin
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  username    String     @unique
  password    String
  description String?
  pic         String
  picPublicId String?
  isActive    Boolean    @default(false)
  visibility  Boolean    @default(true)

  role         UserRole   @default(common)
}