generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  common
  admin
  superAdmin
}

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  username    String     @unique
  password    String
  description String?
  pic         String
  picPublicId String?
  isActive    Boolean    @default(false)
  visibility  Boolean    @default(true)
  cv          String?
  cvPublicId  String?       
  role         UserRole   @default(common)
  
  verificationToken EmailVerificationToken?
  
  jobs         Job[]
  warnings    Warning[]
  savedJobs   SavedJob[]
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Location {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  isActive Boolean  @default(true)
  jobs     Job[]
}

enum JobState {
  active
  paused
  finished
}

enum JobModality {
  remote
  hybrid
  onSite
}

enum JobSchedule {
  partTime
  fullTime
}

model Job {
  id               Int @id @default(autoincrement())
  title            String
  description      String
  salary           Int?
  createdAt        DateTime @default(now())
  isActive         Boolean @default(true)
  isSuspended      Boolean @default(false)
  applicationLimit Int?
  
  state            JobState @default(active)
  modality         JobModality
  schedule         JobSchedule

  locationId       Int
  location         Location @relation(fields: [locationId], references: [id])

  userId           Int
  user             User @relation(fields: [userId], references: [id])
  warning          Warning?   

  savedBy          SavedJob[]            
}

model Warning {
  id        Int      @id @default(autoincrement())
  reason    String
  createdAt DateTime @default(now())

  jobId      Int     @unique
  job        Job     @relation(fields: [jobId], references: [id])

  userId     Int
  user       User    @relation(fields: [userId], references: [id])
}

model SavedJob {
  userId    Int
  jobId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  @@id([userId, jobId])
}