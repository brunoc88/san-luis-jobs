{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "dotenv -e .env.test",
    "test:u": "dotenv -e .env.test -- vitest test/user/user.create.test.ts",
    "test:e": "dotenv -e .env.test -- vitest test/mail/mail.service.test.ts",
    "test:a": "dotenv -e .env.test -- vitest test/auth/reset.password.pt2.test.ts",
    "test:l": "dotenv -e .env.test -- vitest test/location/location.create.test.ts",
    "test:j": "dotenv -e .env.test -- vitest test/job/job.index.test.ts",
    "test:f": "dotenv -e .env.test -- vitest test/feedback/feedback.delete.test.ts",
    "prisma:generate:test": "dotenv -e .env.test -- prisma generate",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate dev",
    "prisma:migrate:reset:test": "dotenv -e .env.test -- prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "prisma": "^6.16.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
